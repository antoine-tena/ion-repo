"""Command-line interface: reads the arguments, calls the core, writes the result.

No computation here ([THIN-CLI]): the work lives in pure modules, tested without a terminal.
"""

import argparse
import sys
from collections.abc import Sequence
from importlib.metadata import version
from typing import TextIO

from {{ name | replace('-', '_') }}.greeting import build_greeting

PROGRAM = "{{ name }}"
# The installed package the version is read from{{ ', its name on PyPI' if pypi_name | default('') else '' }}.
DISTRIBUTION = "{{ pypi_name | default('', true) or name }}"
EXIT_OK = 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=PROGRAM, description=__doc__)
    parser.add_argument("--version", action="version", version=f"%(prog)s {version(DISTRIBUTION)}")
    parser.add_argument("name", nargs="?", default="", help={{ '"à qui dire bonjour"' if language_ui == 'fr' else '"who to greet"' }})
    return parser


def main(argv: Sequence[str] | None = None, out: TextIO = sys.stdout) -> int:
    args = build_parser().parse_args(argv)
    out.write(build_greeting(args.name) + "\n")
    return EXIT_OK
