#!/usr/bin/env bash
# Smoke test after a deployment: the chain as a visitor sees it, from outside.
#
# Usage:    scripts/ops/smoke-test.sh [expected_version]
# Settings: API_URL and SITE_URL override config/vps/project.json. Add here a check per important
#           public read of the project (check, json_true, cors_open, fetch:
#           scripts/ops/lib/smoke.sh).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
{% raw -%}
# shellcheck source=SCRIPTDIR/lib/vps-target.sh
. scripts/ops/lib/vps-target.sh
# shellcheck source=SCRIPTDIR/lib/smoke.sh
. scripts/ops/lib/smoke.sh
API="${API_URL:-$(vps_target apiUrl)}"
SITE="${SITE_URL:-$(vps_target siteUrl)}"
EXPECTED_VERSION="${1:-}"

echo "Smoke test: $API (site: $SITE)"
check "liveness probe /api/health" json_true "$API/api/health" "data['status'] == 'ok'"
check "readiness probe /api/ready (database)" json_true "$API/api/ready" "data['status'] == 'ok'"
if [ -n "$EXPECTED_VERSION" ]; then
  check "deployed version ${EXPECTED_VERSION:0:12}" json_true "$API/api/health" "data['version'] == '$EXPECTED_VERSION'"
fi
smoke_summary
{%- endraw %}
