{%- set fr = language_ui == 'fr' -%}
package {{ java_package }}.greeting;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;

import org.junit.jupiter.api.Test;

class GreetingServiceTest {

    private final GreetingService greetingService = new GreetingService();

    @Test
    void greetsGivenName() {
        assertEquals("{{ 'Bonjour, Ada !' if fr else 'Hello, Ada!' }}", greetingService.greet("  Ada "));
    }

    @Test
    void blankNameFallsBackToDefault() {
        assertEquals("{{ 'Bonjour, monde !' if fr else 'Hello, world!' }}", greetingService.greet("  "));
    }

    @Test
    void nullNameIsRejected() {
        assertThrows(NullPointerException.class, () -> greetingService.greet(null));
    }
}
