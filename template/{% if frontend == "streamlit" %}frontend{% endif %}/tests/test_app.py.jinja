{% if backend in ['django', 'fastapi'] -%}
import pytest
{% endif -%}
from streamlit.testing.v1 import AppTest

from dashboard.constants import {% if backend in ['django', 'fastapi'] %}BACKEND_DOWN_MESSAGE, {% endif %}SITE_TITLE

# Relative to this test file, as AppTest.from_file expects.
APP_SCRIPT = "../app.py"
{% if backend in ['django', 'fastapi'] %}

def test_home_reports_unreachable_backend(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setattr("dashboard.home.fetch_health_status", lambda: None)

    app = AppTest.from_file(APP_SCRIPT).run()

    assert not app.exception
    assert app.title[0].value == SITE_TITLE
    assert app.error[0].value == BACKEND_DOWN_MESSAGE
{%- else %}

def test_home_renders_title() -> None:
    app = AppTest.from_file(APP_SCRIPT).run()

    assert not app.exception
    assert app.title[0].value == SITE_TITLE
{%- endif %}
