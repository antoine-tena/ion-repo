{%- set base = name | replace('-', '_') -%}
{%- set front_port = {'nuxt': 3000, 'next': 3000, 'astro': 4321, 'streamlit': 8501, 'dash': 8050}.get(frontend) -%}
# The project's stack under podman: `kiln dev --containers` (podman-compose up --build).
# Images built from the root of the repo (`.containerignore`); never docker.
name: {{ name }}

services:
{%- if backend == 'django' %}
  db:
    image: docker.io/library/postgres:16-alpine
    environment:
      POSTGRES_USER: {{ base }}
      # Local database of the machine, never exposed: this password protects nothing else.
      POSTGRES_PASSWORD: {{ base }}_local
      POSTGRES_DB: {{ base }}
    volumes:
      - db-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ base }}"]
      interval: 5s
      timeout: 5s
      retries: 10
{%- endif %}
{%- if backend in ['django', 'fastapi'] %}

  backend:
    build:
      context: .
      dockerfile: backend/Containerfile
    env_file:
      - backend/.env
{%- if backend == 'django' %}
    # The image serves gunicorn without migrating; locally: migrations, then the dev server.
    command: ["sh", "-c", "python manage.py migrate && exec python manage.py runserver 0.0.0.0:8000"]
    environment:
      DATABASE_URL: postgres://{{ base }}:{{ base }}_local@db:5432/{{ base }}
      DJANGO_ALLOWED_HOSTS: localhost,127.0.0.1,backend
    depends_on:
      db:
        condition: service_healthy
{%- endif %}
    ports:
      - "8000:8000"
{%- elif backend == 'data' %}

  notebooks:
    build:
      context: .
      dockerfile: backend/Containerfile
    ports:
      - "2718:2718"
{%- endif %}
{%- if frontend != 'none' %}

  frontend:
    build:
      context: .
      dockerfile: frontend/Containerfile
{%- if backend in ['django', 'fastapi'] %}
    environment:
      BACKEND_URL: http://backend:8000
      API_URL: http://backend:8000
    depends_on:
      - backend
{%- endif %}
    ports:
      - "{{ front_port }}:{{ front_port }}"
{%- endif %}
{%- if backend == 'django' %}

volumes:
  db-data:
{%- endif %}
