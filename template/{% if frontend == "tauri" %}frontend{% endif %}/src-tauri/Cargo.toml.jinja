[package]
name = "{{ name }}"
version = "0.1.0"
description = "{{ description | replace('\\', '\\\\') | replace('"', '\\"') }}"
edition = "2024"
rust-version = "1.99"
publish = false

# The core as a library: `main.rs` only starts it, the tests reach it.
[lib]
name = "{{ name | replace('-', '_') }}_lib"
crate-type = ["staticlib", "cdylib", "rlib"]

[build-dependencies]
tauri-build = { version = "2.7.4", features = [] }

[dependencies]
tauri = { version = "2.12.5", features = [] }
serde = { version = "1.0.229", features = ["derive"] }
serde_json = "1.0.154"

[lints.rust]
unsafe_code = "forbid"

[lints.clippy]
# [ERROR-HANDLING]: an error is returned to the front, never a panic in a command.
unwrap_used = "deny"

# A small installer: https://v2.tauri.app/concept/size/
[profile.release]
codegen-units = 1
lto = true
opt-level = "s"
panic = "abort"
strip = true
