{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{ title | replace('\\', '\\\\') | replace('"', '\\"') }}",
  "identifier": "{% if owner %}io.github.{{ owner | lower | replace('-', '') }}{% else %}com.example{% endif %}.{{ name | replace('-', '') }}",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "{{ title | replace('\\', '\\\\') | replace('"', '\\"') }}",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
