{%- set bd = backend_dir | default('backend') %}{%- set fd = frontend_dir | default('frontend') %}{%- set bp = '' if bd == '.' else bd ~ '/' %}{%- set fp = '' if fd == '.' else fd ~ '/' %}{%- set bdir = bd ~ '/' %}{%- set fdir = fd ~ '/' -%}
# Guards and CI checks replayed before each commit.
#
# Installed once, at the root of the repo: kiln install (or: uv tool install pre-commit &&
# pre-commit install). The hook holds for the main tree and every worktree. Replay everything:
#   pre-commit run --all-files
# Local hooks call the project's tools (uv) and `charter`, installed with kiln: fast linters on
# the committed files alone. Typing, tests and the CI run only when a release goes out (skill
# /kiln:release), never at a push to develop.
default_install_hook_types: [pre-commit]
default_stages: [pre-commit]
repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      # [NO-COMMIT-ON-MAIN]: refuses any commit made on main or develop. GitHub also refuses a
      # force-push of develop and any push on main (rulesets).
      - id: no-commit-to-branch
        args: [--branch, main, --branch, develop]
      - id: check-added-large-files
        args: [--maxkb=1024]
{%- if large_files | default([]) %}
        # Heavy files kept on purpose, by their exact path: `kiln set large_files=…`.
        exclude: '^({{ large_files | map('replace', '.', '\\.') | join('|') }})$'
{%- endif %}
      - id: check-merge-conflict
      - id: detect-private-key
      - id: end-of-file-fixer
      - id: trailing-whitespace
        args: [--markdown-linebreak-ext=md]
      - id: check-yaml
        # The pnpm lockfile holds several YAML documents.
        args: [--allow-multiple-documents]
      - id: check-json

  - repo: local
    hooks:
{%- set python_dirs = ([bd] if backend in ['django', 'fastapi', 'data', 'cli'] else []) + ([fd] if frontend in ['streamlit', 'dash'] else []) %}
{%- for directory in python_dirs %}
{%- set prefix = '' if directory == '.' else directory ~ '/' %}
{%- set label = 'root' if directory == '.' else directory %}
      - id: ruff-check-{{ label }}
        name: ruff check ({{ label }})
        entry: bash -c 'cd {{ directory }} && uv run ruff check --fix --force-exclude "${@#{{ prefix }}}"' --
        language: system
        types: [python]
        files: ^{{ prefix }}

      - id: ruff-format-{{ label }}
        name: ruff format ({{ label }})
        entry: bash -c 'cd {{ directory }} && uv run ruff format --force-exclude "${@#{{ prefix }}}"' --
        language: system
        types: [python]
        files: ^{{ prefix }}
{% endfor %}
{%- if frontend in ['nuxt', 'next'] %}
      - id: eslint
        name: eslint (frontend)
        entry: bash -c 'cd {{ fd }} && pnpm exec eslint --fix "${@#{{ fp }}}"' --
        language: system
        files: ^{{ fp }}.*\.(vue|ts|tsx|mjs)$
{% endif %}
      - id: charter
        name: charter (charter.toml, committed files)
        entry: charter file
        language: system
