# Guards and CI checks replayed before each commit.
#
# Installed once, at the root of the repo: kiln install (or: uv tool install pre-commit &&
# pre-commit install). The hook holds for the main tree and every worktree. Replay everything:
#   pre-commit run --all-files
# Local hooks call the project's tools (uv) and `charter`, installed with kiln. Typing, too slow
# for each commit, runs before each push: `develop` no longer gets the full CI, which only runs
# when a release goes out (skill /kiln:release).
default_install_hook_types: [pre-commit, pre-push]
default_stages: [pre-commit]
repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      # [NO-COMMIT-ON-MAIN]: refuses any commit made on main or develop. GitHub also refuses a
      # force-push of develop and any push on main (rulesets).
      - id: no-commit-to-branch
        args: [--branch, main, --branch, develop]
      - id: check-added-large-files
        args: [--maxkb=1024]
      - id: check-merge-conflict
      - id: detect-private-key
      - id: end-of-file-fixer
      - id: trailing-whitespace
        args: [--markdown-linebreak-ext=md]
      - id: check-yaml
        # The pnpm lockfile holds several YAML documents.
        args: [--allow-multiple-documents]
      - id: check-json

  - repo: local
    hooks:
{%- set python_dirs = (['backend'] if backend in ['django', 'fastapi', 'data', 'cli'] else []) + (['frontend'] if frontend in ['streamlit', 'dash'] else []) %}
{%- for directory in python_dirs %}
      - id: ruff-check-{{ directory }}
        name: ruff check ({{ directory }})
        entry: bash -c 'cd {{ directory }} && uv run ruff check --fix --force-exclude "${@#{{ directory }}/}"' --
        language: system
        types: [python]
        files: ^{{ directory }}/

      - id: ruff-format-{{ directory }}
        name: ruff format ({{ directory }})
        entry: bash -c 'cd {{ directory }} && uv run ruff format --force-exclude "${@#{{ directory }}/}"' --
        language: system
        types: [python]
        files: ^{{ directory }}/
{% endfor %}
{%- if frontend in ['nuxt', 'next'] %}
      - id: eslint
        name: eslint (frontend)
        entry: bash -c 'cd frontend && pnpm exec eslint --fix "${@#frontend/}"' --
        language: system
        files: ^frontend/.*\.(vue|ts|tsx|mjs)$
{% endif %}
{%- if backend in ['django', 'fastapi', 'data', 'cli'] %}
      - id: typing-backend
        name: mypy typing (backend, before push)
        entry: {% if backend == 'django' %}charter types{% else %}bash -c 'cd backend && uv run mypy .'{% endif %}
        language: system
        pass_filenames: false
        always_run: true
        stages: [pre-push]
{% endif %}
{%- if backend == 'java' %}
      - id: compile-backend
        name: Java compilation (backend, before push)
        entry: bash -c 'cd backend && ./mvnw -q -B -DskipTests compile'
        language: system
        pass_filenames: false
        always_run: true
        stages: [pre-push]
{% endif %}
{%- if frontend in ['nuxt', 'next', 'astro'] %}
      - id: typing-frontend
        name: TypeScript typing (frontend, before push)
        entry: pnpm --dir frontend typecheck
        language: system
        pass_filenames: false
        always_run: true
        stages: [pre-push]
{% endif %}
      - id: charter
        name: charter (charter.toml)
        entry: charter
        language: system
        pass_filenames: false
        always_run: true
