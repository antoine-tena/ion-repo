{# The kiln release the project comes from: its workflows are cited at that tag, and
    `kiln update` moves it forward. A template taken outside a release (kiln's development)
    cites develop. #}
{%- set kiln_commit = _copier_answers._commit | default('') | string %}
{%- set kiln_ref = kiln_commit if (kiln_commit.startswith('v') and '-g' not in kiln_commit) else 'develop' -%}
name: CI

# The reusable workflows live in kiln (antoine-tena/kiln, public), cited at the kiln release the
# project comes from ({{ kiln_ref }}): `kiln update` moves them to the next one. The project only
# keeps its parameters here.
on:
{%- if ci_runner | default('github') == 'github' %}
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main, develop ]
{%- else %}
  # The CI of each push runs on the machine (`kiln ci`, verdict kept as a git note): no GitHub
  # minutes. On GitHub, by hand: Actions, CI, Run workflow. Back on each push:
  # `kiln set ci_runner=github`.
  workflow_dispatch:
{%- endif %}
  # Replayed by deploy.yml before any production release.
  workflow_call:

jobs:
{%- if backend == 'django' %}
  backend:
    uses: antoine-tena/kiln/.github/workflows/django.yml@{{ kiln_ref }}
    with:
      database: {{ name | replace('-', '_') }}
      env: |
        DJANGO_SECRET_KEY=ci-without-secret-value
        DJANGO_DEBUG=True
{%- elif backend in ['fastapi', 'data', 'cli'] %}
  backend:
    uses: antoine-tena/kiln/.github/workflows/python.yml@{{ kiln_ref }}
    with:
      directory: backend
{%- elif backend == 'java' %}
  backend:
    uses: antoine-tena/kiln/.github/workflows/maven.yml@{{ kiln_ref }}
    with:
      directory: backend
{%- endif %}
{%- if frontend in ['nuxt', 'next', 'astro'] %}

  frontend:
    uses: antoine-tena/kiln/.github/workflows/pnpm.yml@{{ kiln_ref }}
    with:
      scripts: |
{%- if frontend != 'astro' %}
        lint
{%- endif %}
        typecheck
        build
{%- elif frontend in ['streamlit', 'dash'] %}

  frontend:
    uses: antoine-tena/kiln/.github/workflows/python.yml@{{ kiln_ref }}
    with:
      directory: frontend
{%- endif %}
{%- if backend == 'django' and frontend == 'nuxt' %}

  api-contract:
    uses: antoine-tena/kiln/.github/workflows/api-contract.yml@{{ kiln_ref }}
    with:
      env: |
        DJANGO_SECRET_KEY=ci-without-secret-value
{%- endif %}

  charter:
    uses: antoine-tena/kiln/.github/workflows/charter.yml@{{ kiln_ref }}

  # [SECRETS]: gitleaks searches the whole history, with no organisation licence.
  secrets-scan:
    uses: antoine-tena/kiln/.github/workflows/secrets.yml@{{ kiln_ref }}

{%- set uv_dirs = (['backend'] if backend not in ['none', 'java'] else []) + (['frontend'] if frontend in ['streamlit', 'dash'] else []) %}
{%- set pnpm_dir = 'frontend' if frontend in ['nuxt', 'next', 'astro'] else '' %}
{%- if uv_dirs or pnpm_dir %}

  security:
    uses: antoine-tena/kiln/.github/workflows/security.yml@{{ kiln_ref }}
    with:
      uv: "{{ uv_dirs | join(' ') }}"
      pnpm: "{{ pnpm_dir }}"
{%- endif %}
{%- if podman %}

  containers:
    uses: antoine-tena/kiln/.github/workflows/infra.yml@{{ kiln_ref }}
    with:
      containerfiles: "{{ ((['backend/Containerfile'] if backend not in ['none', 'cli', 'java'] else []) + (['frontend/Containerfile'] if frontend != 'none' else [])) | join(' ') }}"
      compose: compose.yaml
{%- if backend in ['django', 'fastapi'] %}
      setup: cp backend/.env.example backend/.env
{%- endif %}
{%- endif %}
