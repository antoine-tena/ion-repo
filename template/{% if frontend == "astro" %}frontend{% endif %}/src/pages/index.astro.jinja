---
import BaseLayout from '../layouts/BaseLayout.astro';
import { {% if backend in ['django', 'fastapi'] %}BACKEND_CONNECTING, {% endif %}SITE_DESCRIPTION, SITE_TITLE } from '../constants';
---

<BaseLayout>
  <main class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center gap-4 p-6">
    <h1 class="text-3xl font-bold text-brand">{SITE_TITLE}</h1>
    <p class="text-gray-600">{SITE_DESCRIPTION}</p>
{%- if backend in ['django', 'fastapi'] %}
    <p id="health-status" class="text-gray-500">{BACKEND_CONNECTING}</p>
{%- endif %}
  </main>
</BaseLayout>
{%- if backend in ['django', 'fastapi'] %}

<script>
  // Minimal island ([MODERN-ASTRO]): the state of the API is read in the browser, the rest is static.
  import { BACKEND_DOWN, BACKEND_UNHEALTHY, BACKEND_UP } from '../constants';

  const healthStatus = document.getElementById('health-status');

  async function showHealth(): Promise<void> {
    if (healthStatus === null) {
      return;
    }
    try {
      const response = await fetch('/api/health');
      const payload: unknown = await response.json();
      const isHealthy = response.ok && typeof payload === 'object' && payload !== null && 'status' in payload;
      healthStatus.textContent = isHealthy ? BACKEND_UP : BACKEND_UNHEALTHY;
    } catch (error) {
      // [EXCEPTIONS]: backend unreachable, shown as such.
      console.error('health.unreachable', error);
      healthStatus.textContent = BACKEND_DOWN;
    }
  }

  void showHealth();
</script>
{%- endif %}
