<script setup lang="ts">
import { useHealth } from '~/composables/useHealth'
import { BACKEND_CONNECTING, BACKEND_DOWN, BACKEND_UP } from '~/utils/constants'

const { data: health, status } = await useHealth()
</script>

<template>
  <p v-if="status === 'pending'" class="text-muted">
    {{ BACKEND_CONNECTING }}
  </p>
  <p v-else-if="status === 'error'" class="text-danger">
    {{ BACKEND_DOWN }}
  </p>
  <p v-else class="text-success">
    {{ BACKEND_UP }} ({{ health?.status }})
  </p>
</template>
