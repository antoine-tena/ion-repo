# Image of frontend/: the Nuxt server (Nitro).
# Built from the root of the repo (compose.yaml, or podman build -f frontend/Containerfile .).
# pnpm through corepack, never a global npm install; a non-root user ([HARDENED-CONTAINERS]).
FROM docker.io/library/node:24-trixie-slim@sha256:7f486cabe892bff8fef04c0f7da8dba84a560be3e4e2740b7a86afc57ebec315
RUN corepack enable
WORKDIR /srv/frontend
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY frontend/ ./
{%- if backend in ['django', 'fastapi'] %}
# The /api relay is fixed at build time (routeRules of nuxt.config.ts).
ARG NUXT_BACKEND_URL=http://backend:8000
ENV NUXT_BACKEND_URL=$NUXT_BACKEND_URL
{%- endif %}
RUN pnpm build && chown -R node /srv
USER node
ENV HOST=0.0.0.0 PORT=3000
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
