// https://nuxt.com/docs/api/configuration/nuxt-config
import tailwindcss from '@tailwindcss/vite'

{%- if backend in ['django', 'fastapi'] %}

// Origin of the backend in development, target of the '/api/**' proxy below.
const DEFAULT_BACKEND_ORIGIN = 'http://localhost:8000'

const env = (globalThis as { process?: { env?: Record<string, string | undefined> } }).process?.env ?? {}
const backendOrigin = env.NUXT_BACKEND_URL ?? DEFAULT_BACKEND_ORIGIN
{%- endif %}

export default defineNuxtConfig({
  compatibilityDate: '2025-07-15',
  devtools: { enabled: true },
  modules: ['@nuxt/eslint'],
  // [EXPLICIT-IMPORTS]: the project's components are imported by hand.
  components: { dirs: [] },
  css: ['~/assets/css/main.css'],
  vite: { plugins: [tailwindcss()] },
  typescript: { strict: true, typeCheck: false },
  app: { head: { htmlAttrs: { lang: '{{ 'fr' if language_ui == 'fr' else 'en' }}' } } },
{%- if backend == 'fastapi' %}
  runtimeConfig: {
    public: { apiBase: '/api' }
  },
{%- endif %}
{%- if backend in ['django', 'fastapi'] %}
  routeRules: {
    '/api/**': { proxy: `${backendOrigin}/api/**` }
  }
{%- endif %}
})
