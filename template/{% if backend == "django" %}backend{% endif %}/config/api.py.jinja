"""Entry point of the Django Ninja API ([NINJA])."""

from django.conf import settings
from django.http import HttpRequest
from ninja import NinjaAPI, Router, Schema

from config.health import is_database_reachable

HEALTH_STATUS_OK = "ok"
HEALTH_STATUS_UNAVAILABLE = "unavailable"
HTTP_OK = 200
HTTP_SERVICE_UNAVAILABLE = 503

api = NinjaAPI(title={{ py_str(title ~ " API") }}, version="1.0.0")
health_router = Router(tags=["health"])


class HealthResponse(Schema):
    status: str
    # Commit in service: the production switch checks that the new version answers.
    version: str


# [PERMISSIONS]: public route, without data, used as the liveness probe ([HEALTH-PROBES]).
@health_router.get("/health", response=HealthResponse, auth=None)
def get_health(request: HttpRequest) -> HealthResponse:
    return HealthResponse(status=HEALTH_STATUS_OK, version=settings.APP_VERSION)


# [PERMISSIONS]: public route, without data; readiness probe, which checks the database.
@health_router.get(
    "/ready",
    response={HTTP_OK: HealthResponse, HTTP_SERVICE_UNAVAILABLE: HealthResponse},
    auth=None,
)
def get_readiness(request: HttpRequest) -> tuple[int, HealthResponse]:
    if not is_database_reachable():
        unavailable = HealthResponse(status=HEALTH_STATUS_UNAVAILABLE, version=settings.APP_VERSION)
        return HTTP_SERVICE_UNAVAILABLE, unavailable
    return HTTP_OK, HealthResponse(status=HEALTH_STATUS_OK, version=settings.APP_VERSION)


api.add_router("/", health_router)
