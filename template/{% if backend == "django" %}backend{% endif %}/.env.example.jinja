{% from "macros.jinja" import db_port -%}
# Copied to .env by `kiln install`; no real value here ([SECRETS]).
DJANGO_SECRET_KEY=to-be-replaced
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production only (DJANGO_DEBUG=False): the SMTP server that sends the mails.
# DJANGO_SMTP_HOST=smtp.example.com
# DJANGO_SMTP_USER=
# DJANGO_SMTP_PASSWORD=
{%- if podman %}
# PostgreSQL of compose.yaml, started by `kiln dev` and `kiln check`; without it, SQLite.
DATABASE_URL=postgres://{{ name | replace('-', '_') }}:{{ name | replace('-', '_') }}_local@localhost:{{ db_port(name) }}/{{ name | replace('-', '_') }}
{%- else %}
# DATABASE_URL=postgres://{{ name }}:{{ name }}@localhost:5432/{{ name }}
{%- endif %}
