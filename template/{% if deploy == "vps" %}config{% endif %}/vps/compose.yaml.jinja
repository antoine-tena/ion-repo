{%- set base = name | replace('-', '_') -%}
# Production stack, run on the server in /opt/{{ name }} by podman-compose. Secrets are not here:
# /opt/{{ name }}/.env (POSTGRES_PASSWORD) and /opt/{{ name }}/backend/.env (Django), created by hand
# once, never versioned ([SECRETS]). The local stack is compose.yaml, at the root of the repo.
name: {{ name }}

services:
  db:
    container_name: {{ name }}-db
    image: docker.io/library/postgres:16-alpine
    restart: always
    environment:
      POSTGRES_USER: {{ base }}
      POSTGRES_DB: {{ base }}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - ./postgres:/var/lib/postgresql/data:Z
    # Database never exposed: only the backend and the server's scripts reach it.
    ports:
      - "127.0.0.1:5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ base }}"]
      interval: 10s
      timeout: 5s
      retries: 10

  backend:
    container_name: {{ name }}-backend
    # Built and tagged by the switch script (deploy-remote.sh), one image per commit.
    image: localhost/{{ base }}_backend:latest
    restart: always
    env_file:
      - backend/.env
    environment:
      DATABASE_URL: postgres://{{ base }}:${POSTGRES_PASSWORD}@127.0.0.1:5432/{{ base }}
    # Host network: the database on 127.0.0.1, the API reached by Caddy on 127.0.0.1:8000.
    network_mode: host
    # [HARDENED-CONTAINERS]: read-only file system, no capability.
    read_only: true
    tmpfs:
      - /tmp
    cap_drop:
      - ALL
    depends_on:
      db:
        condition: service_healthy
    healthcheck:
      # Under the public name: Django refuses a host missing from DJANGO_ALLOWED_HOSTS.
      test: ["CMD", "python", "-c", "import urllib.request as r; r.urlopen(r.Request('http://127.0.0.1:8000/api/ready', headers={'Host': '{{ api_domain }}', 'X-Forwarded-Proto': 'https'}), timeout=5)"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s
