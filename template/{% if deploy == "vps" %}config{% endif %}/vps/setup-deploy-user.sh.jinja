#!/usr/bin/env bash
# Creates the server's `deploy` user, so as to stop deploying as root.
#
# Run once, as root, on the server: bash setup-deploy-user.sh "<SSH public key>"
# Deployments then use DEPLOY_HOST=deploy@<server> (or "host" in config/vps/project.json). The
# user has one right only: running, as root, the switch script installed by the deployment
# (/usr/local/sbin/{{ name }}-deploy-remote).
set -euo pipefail

KEY="${1:?SSH public key expected}"
id deploy > /dev/null 2>&1 || useradd --create-home --shell /bin/bash deploy
install -d -m 700 -o deploy -g deploy /home/deploy/.ssh
printf '%s\n' "$KEY" > /home/deploy/.ssh/authorized_keys
chown deploy:deploy /home/deploy/.ssh/authorized_keys
chmod 600 /home/deploy/.ssh/authorized_keys
install -d -m 750 -o deploy -g deploy /home/deploy/incoming
echo 'deploy ALL=(root) NOPASSWD: /usr/local/sbin/{{ name }}-deploy-remote' > /etc/sudoers.d/{{ name }}-deploy
chmod 440 /etc/sudoers.d/{{ name }}-deploy
visudo -cf /etc/sudoers.d/{{ name }}-deploy
echo "deploy user ready: DEPLOY_HOST=deploy@$(hostname -I | awk '{print $1}')"
