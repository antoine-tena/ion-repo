{%- set api = backend == 'django' %}
{%- set domain = api_domain if api else site_url.split('://')[-1].split('/')[0] %}
{%- set port = vps_port if api else (8501 if frontend == 'streamlit' else 8050) -%}
# Caddy site of the project: automatic TLS (Let's Encrypt) and headers, in front of the {{ 'API' if api else 'app' }} on
# 127.0.0.1:{{ port }}. Installed by the switch (deploy-remote.sh) as /etc/caddy/sites/{{ name }}.caddy,
# which the server's Caddyfile imports (a server shared with other projects keeps their sites).
{{ domain }} {
	tls admin@{{ domain.split('.')[-2:] | join('.') }}
	encode zstd gzip
{%- if api %}

	# [SECURITY-HEADERS]: Django already sets HSTS, nosniff, referrer and COOP; what gives the
	# server away goes.
	header -Server
{%- else %}

	# [SECURITY-HEADERS]: what the app does not set; what gives the server away goes.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
{%- endif %}

	log {
		output file /var/log/caddy/{{ name }}-access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format json
	}

	# Websockets{{ ' (Streamlit)' if frontend == 'streamlit' else '' }} go through as they are.
	reverse_proxy 127.0.0.1:{{ port }} {
		header_up X-Forwarded-Proto {scheme}
		health_uri {{ '/api/health' if api else ('/_stcore/health' if frontend == 'streamlit' else '/') }}
		health_interval 30s
{%- if api %}
		# Under the public name: Django refuses a host missing from DJANGO_ALLOWED_HOSTS, and Caddy
		# would then take the API for down.
		health_headers {
			Host {{ domain }}
			X-Forwarded-Proto https
		}
{%- endif %}
	}
}
