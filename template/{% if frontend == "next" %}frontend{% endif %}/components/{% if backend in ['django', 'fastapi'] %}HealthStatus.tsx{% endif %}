import { connection } from "next/server";

import { getHealth } from "@/lib/api";
import { BACKEND_DOWN, BACKEND_UP } from "@/lib/constants";

// Server component ([MODERN-REACT]): the state of the API is read at each request, no useEffect.
export default async function HealthStatus() {
  await connection();
  const health = await getHealth();
  if (health === null) {
    return <p className="text-red-700">{BACKEND_DOWN}</p>;
  }
  return (
    <p className="text-green-700">
      {BACKEND_UP} ({health.status})
    </p>
  );
}
