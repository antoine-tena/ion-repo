# Image of frontend/: the Next.js server.
# Built from the root of the repo (compose.yaml, or podman build -f frontend/Containerfile .).
# pnpm through corepack, never a global npm install; a non-root user ([HARDENED-CONTAINERS]).
FROM docker.io/library/node:24-trixie-slim@sha256:54f84b4cf8432b21aaffd5d3ce8d41e12cea0d10d33c09d2f3c9879d49d6b446
RUN corepack enable
WORKDIR /srv/frontend
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY frontend/ ./
{%- if backend in ['django', 'fastapi'] %}
# The /api relay is fixed at build time (rewrites of next.config.ts).
ARG BACKEND_URL=http://backend:8000
ENV BACKEND_URL=$BACKEND_URL
{%- endif %}
RUN pnpm build && chown -R node /srv
USER node
EXPOSE 3000
# Started without pnpm: corepack would fetch pnpm at start, into a read-only file system.
CMD ["node_modules/.bin/next", "start", "--hostname", "0.0.0.0"]
