"""Plotly figures: one function per figure, which receives already transformed data."""

import plotly.graph_objects as go
import polars as pl

# Okabe-Ito palette, readable by colour-blind people ([ACCESSIBLE-FIGURES]).
COLORBLIND_PALETTE = ("#0072B2", "#E69F00", "#009E73", "#CC79A7", "#56B4E9", "#D55E00")


def monthly_totals_figure(totals: pl.DataFrame) -> go.Figure:
    """Lines of the monthly totals, one per category, axes titled with their unit."""
    figure = go.Figure()
    for index, category in enumerate(totals["category"].unique(maintain_order=True)):
        category_totals = totals.filter(pl.col("category") == category)
        figure.add_trace(
            go.Scatter(
                x=category_totals["month"].to_list(),
                y=category_totals["total"].to_list(),
                name=str(category),
                mode="lines+markers",
                line={"color": COLORBLIND_PALETTE[index % len(COLORBLIND_PALETTE)]},
            )
        )
    figure.update_layout(
        title="{{ 'Totaux mensuels par catégorie' if fr else 'Monthly totals by category' }}",
        xaxis_title="{{ 'Mois' if fr else 'Month' }}",
        yaxis_title="{{ 'Total (unités)' if fr else 'Total (units)' }}",
    )
    return figure
