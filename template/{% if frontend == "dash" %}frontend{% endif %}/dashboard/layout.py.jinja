"""Layout: a function that builds the application, evaluated at start."""

{% if backend == 'data' -%}
from dash import Dash, dcc, html
from pipeline.sources import load_measurements
from pipeline.transforms import monthly_totals

from dashboard import callbacks
from dashboard.constants import (
    ALL_CATEGORIES,
    CATEGORY_DROPDOWN_ID,
    CATEGORY_LABEL,
    SITE_DESCRIPTION,
    SITE_TITLE,
    TOTALS_GRAPH_ID,
)


def build_layout() -> html.Main:
    categories = monthly_totals(load_measurements())["category"].unique(maintain_order=True)
    return html.Main(
        [
            html.H1(SITE_TITLE),
            html.P(SITE_DESCRIPTION),
            html.Label(CATEGORY_LABEL, htmlFor=CATEGORY_DROPDOWN_ID),
            dcc.Dropdown(
                id=CATEGORY_DROPDOWN_ID,
                options=[ALL_CATEGORIES, *categories.to_list()],
                value=ALL_CATEGORIES,
                clearable=False,
            ),
            dcc.Loading(dcc.Graph(id=TOTALS_GRAPH_ID)),
        ]
    )


def create_app() -> Dash:
    app = Dash(__name__, title=SITE_TITLE)
    app.layout = build_layout
    callbacks.register()
    return app
{%- elif backend in ['django', 'fastapi'] -%}
from dash import Dash, html

from dashboard.api import fetch_health_status
from dashboard.constants import (
    BACKEND_DOWN_MESSAGE,
    BACKEND_UP_MESSAGE,
    SITE_DESCRIPTION,
    SITE_TITLE,
)


def health_message() -> str:
    health_status = fetch_health_status()
    if health_status is None:
        return BACKEND_DOWN_MESSAGE
    return BACKEND_UP_MESSAGE.format(status=health_status)


def build_layout() -> html.Main:
    # Evaluated at each page load: the state of the API is always fresh.
    return html.Main([html.H1(SITE_TITLE), html.P(SITE_DESCRIPTION), html.P(health_message())])


def create_app() -> Dash:
    app = Dash(__name__, title=SITE_TITLE)
    app.layout = build_layout
    return app
{%- else -%}
