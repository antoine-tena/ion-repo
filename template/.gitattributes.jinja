{%- set bd = backend_dir | default('backend') %}{%- set fd = frontend_dir | default('frontend') %}{%- set bp = '' if bd == '.' else bd ~ '/' %}{%- set fp = '' if fd == '.' else fd ~ '/' %}{%- set bdir = bd ~ '/' %}{%- set fdir = fd ~ '/' -%}
# Line endings normalised to LF in the repo, whatever the machine (Windows included).
* text=auto eol=lf
{%- if backend == 'java' %}
# Windows scripts of the Maven wrapper: CRLF line endings, as cmd.exe expects.
*.cmd text eol=crlf
{%- endif %}

# Binaries.
*.png binary
*.jpg binary
*.ico binary
*.npz binary

# Generated files, exempt from [FILE-SIZE].
{%- if backend in ['django', 'fastapi', 'data', 'cli'] %}
{{ bp }}uv.lock linguist-generated=true
{%- endif %}
{%- if frontend in ['streamlit', 'dash'] %}
{{ fp }}uv.lock linguist-generated=true
{%- elif frontend != 'none' %}
{{ fp }}pnpm-lock.yaml linguist-generated=true
{%- endif %}
{%- if backend == 'django' and frontend == 'nuxt' %}
# API contract: `ion repo contract` regenerates them, CI (api-contract.yml) checks their drift.
openapi.json linguist-generated=true
{{ fp }}app/types/api.d.ts linguist-generated=true
{%- endif %}
{%- if backend == 'data' %}
# Trained models: regenerated by their training command (data/README.md).
{{ bp }}data/models/** linguist-generated=true
{%- endif %}
